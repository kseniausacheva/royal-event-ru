{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:com",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/en/blog/konferenciya-v-egipte/",
      "destination": "/en/blog/conference-in-egypt/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/gala-uzhin-v-egipte/",
      "destination": "/en/blog/gala-dinner-in-egypt/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/mice4u-2026-egipet-mice-dmc/",
      "destination": "/en/blog/mice4u-2026-egypt-mice-destination/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/shakira-piramidy-gizy-bilety/",
      "destination": "/en/blog/shakira-pyramids-of-giza-tickets/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/dmc-v-egipte/",
      "destination": "/en/blog/dmc-in-egypt/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/organizaciya-meropriyatiya-za-granicej-s-dmc/",
      "destination": "/en/blog/corporate-event-abroad-with-a-local-dmc/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/insentiv-tur-v-egipet/",
      "destination": "/en/blog/incentive-travel-to-egypt/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/timbilding-v-egipte/",
      "destination": "/en/blog/team-building-in-egypt/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/korporativnyj-kruiz-po-nilu/",
      "destination": "/en/blog/corporate-nile-cruise/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/organizaciya-konferencii-za-rubezhom/",
      "destination": "/en/blog/conference-abroad-planning-checklist/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/insentiv-tur-dlya-sotrudnikov/",
      "destination": "/en/blog/incentive-travel-for-employees/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/novogodnij-korporativ-za-granicej/",
      "destination": "/en/blog/new-year-corporate-party-abroad/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/skolko-stoit-korporativ-za-rubezhom/",
      "destination": "/en/blog/corporate-event-abroad-cost/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/korporativ-v-egipte-ceny-2026/",
      "destination": "/en/blog/corporate-event-in-egypt-prices-2026/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/kak-vybrat-mice-agentstvo/",
      "destination": "/en/blog/how-to-choose-a-mice-agency/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/gde-provesti-korporativ-v-oae-dubai/",
      "destination": "/en/blog/corporate-event-in-dubai/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/kak-vybrat-vedushchego-dlya-korporativa/",
      "destination": "/en/blog/how-to-choose-a-corporate-event-host/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/6-trendov-v-b2b-pr-na-2026-god/",
      "destination": "/en/blog/b2b-pr-trends-2026/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/gde-provesti-korporativ-v-sharm-el-sheikh/",
      "destination": "/en/blog/corporate-event-in-sharm-el-sheikh/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/kak-podgotovit-programmu-protokolnogo-meropriyatiya/",
      "destination": "/en/blog/protocol-event-program/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/gde-provesti-korporativ-v-egipte/",
      "destination": "/en/blog/corporate-event-venues-in-egypt/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/biznes-retraity-dlya-kompanij-formaty-celi/",
      "destination": "/en/blog/corporate-business-retreats/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/top-8-tendencii-kejteringa-2026/",
      "destination": "/en/blog/catering-trends-2026/",
      "statusCode": 301
    },
    {
      "source": "/en/blog/podvodnye-kamni-konferencii-za-rubezhom/",
      "destination": "/en/blog/conference-abroad-pitfalls/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
